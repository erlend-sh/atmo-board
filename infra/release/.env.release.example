# Self-hosting with infra/release/compose.yml. Copy to infra/release/.env.
#
# Generate the secrets:
#   openssl rand -hex 32     # HAPPYVIEW_SESSION_SECRET, ATMOBOARD_COOKIE_SECRET, POSTGRES_PASSWORD
#   openssl rand -base64 32  # TOKEN_ENCRYPTION_KEY

# Two public URLs, both behind your TLS terminator: the forum, and HappyView
# (which needs its own hostname for OAuth, the service proxy and spaces).
ATMOBOARD_APP_URL=https://forum.example.org
HAPPYVIEW_PUBLIC_URL=https://hv.example.org
# Where the edge and web containers are published locally.
WEB_PORT=3001
EDGE_PORT=8080

POSTGRES_PASSWORD=
HAPPYVIEW_SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
ATMOBOARD_COOKIE_SECRET=

# The forum's group account DID, and the operator key from
# `ADMIN_DID=did:plc:you sh appview/bootstrap-admin.sh` (run once).
ATMOBOARD_FORUM_DID=
HAPPYVIEW_API_KEY=

# The OAuth API client, created once against HappyView's /admin/api-clients
# with client_id_url = $ATMOBOARD_APP_URL/oauth-client-metadata.json and
# redirect_uris = ["$ATMOBOARD_APP_URL/oauth/callback"].
HAPPYVIEW_CLIENT_KEY=
HAPPYVIEW_CLIENT_SECRET=

# Optional: a different atproto relay.
# RELAY_URL=https://relay1.us-east.bsky.network
