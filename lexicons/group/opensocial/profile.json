{
  "lexicon": 1,
  "id": "group.opensocial.profile",
  "defs": {
    "main": {
      "type": "record",
      "description": "Vendored draft (opensocial.group proposal, main @ 2026-10-23). The group's profile, in meta.",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": [
          "displayName",
          "joinPolicy"
        ],
        "properties": {
          "displayName": {
            "type": "string",
            "maxGraphemes": 64,
            "maxLength": 640
          },
          "description": {
            "type": "string",
            "maxGraphemes": 2000,
            "maxLength": 20000
          },
          "joinPolicy": {
            "type": "string",
            "knownValues": [
              "open",
              "approval",
              "invite"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  }
}
