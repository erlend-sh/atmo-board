{
  "lexicon": 1,
  "id": "dev.atmoboard.unreact",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Remove one of the viewer's reactions.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "post",
            "emoji"
          ],
          "properties": {
            "post": {
              "type": "string",
              "minLength": 10,
              "maxLength": 10,
              "description": "Short stable key: the first 50 bits of sha256(at-uri), as 10 lowercase base32 characters."
            },
            "emoji": {
              "type": "string",
              "maxLength": 64,
              "maxGraphemes": 1
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "post",
            "emoji"
          ],
          "properties": {
            "post": {
              "type": "string",
              "minLength": 10,
              "maxLength": 10,
              "description": "Short stable key: the first 50 bits of sha256(at-uri), as 10 lowercase base32 characters."
            },
            "emoji": {
              "type": "string"
            }
          }
        }
      },
      "errors": [
        {
          "name": "NotFound"
        }
      ]
    }
  }
}
