{
  "lexicon": 1,
  "id": "dev.atmoboard.resolveKey",
  "defs": {
    "main": {
      "type": "query",
      "description": "Where a key lives now: its canonical slug, and for a post its thread and number. Backs /p/{key} and slug redirects.",
      "parameters": {
        "type": "params",
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 10,
            "maxLength": 10,
            "description": "Short stable key: the first 50 bits of sha256(at-uri), as 10 lowercase base32 characters."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "kind",
            "key",
            "slug"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "knownValues": [
                "thread",
                "channel",
                "post"
              ]
            },
            "key": {
              "type": "string",
              "minLength": 10,
              "maxLength": 10,
              "description": "Short stable key: the first 50 bits of sha256(at-uri), as 10 lowercase base32 characters."
            },
            "slug": {
              "type": "string"
            },
            "thread": {
              "type": "string",
              "minLength": 10,
              "maxLength": 10,
              "description": "Short stable key: the first 50 bits of sha256(at-uri), as 10 lowercase base32 characters."
            },
            "threadSlug": {
              "type": "string"
            },
            "number": {
              "type": "integer"
            }
          }
        }
      },
      "errors": [
        {
          "name": "NotFound"
        }
      ]
    }
  }
}
