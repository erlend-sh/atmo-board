{
  "lexicon": 1,
  "id": "dev.atmoboard.createThread",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Open a thread. Without parent the thread is top-level (only staff, since that is how channels start).",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "textContent"
          ],
          "properties": {
            "parent": {
              "type": "string",
              "minLength": 10,
              "maxLength": 10,
              "description": "Short stable key: the first 50 bits of sha256(at-uri), as 10 lowercase base32 characters."
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 3000,
              "maxGraphemes": 300
            },
            "textContent": {
              "type": "string",
              "maxLength": 100000,
              "maxGraphemes": 10000
            },
            "content": {
              "type": "union",
              "refs": [
                "dev.atmoboard.defs#markdown"
              ]
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 640,
                "maxGraphemes": 64
              },
              "maxLength": 8
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "key",
            "uri",
            "slug"
          ],
          "properties": {
            "key": {
              "type": "string",
              "minLength": 10,
              "maxLength": 10,
              "description": "Short stable key: the first 50 bits of sha256(at-uri), as 10 lowercase base32 characters."
            },
            "uri": {
              "type": "string",
              "format": "at-uri"
            },
            "slug": {
              "type": "string"
            }
          }
        }
      },
      "errors": [
        {
          "name": "Forbidden"
        },
        {
          "name": "NotFound"
        },
        {
          "name": "Locked"
        }
      ]
    }
  }
}
