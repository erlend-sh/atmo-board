{
  "lexicon": 1,
  "id": "dev.atmoboard.listMembers",
  "defs": {
    "main": {
      "type": "query",
      "description": "The forum's members, most recently joined first. Discourse's /u directory.",
      "parameters": {
        "type": "params",
        "required": [],
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "cursor": {
            "type": "string"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "members"
          ],
          "properties": {
            "members": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "dev.atmoboard.defs#authorView"
              }
            },
            "cursor": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
