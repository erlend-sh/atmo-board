{
  "lexicon": 1,
  "id": "dev.atmoboard.reaction",
  "defs": {
    "main": {
      "type": "record",
      "description": "An emoji reaction to a post. A ❤️ is a Discourse-style like.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "subject",
          "emoji",
          "createdAt"
        ],
        "properties": {
          "subject": {
            "type": "string",
            "format": "at-uri"
          },
          "emoji": {
            "type": "string",
            "maxLength": 64,
            "maxGraphemes": 1
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
