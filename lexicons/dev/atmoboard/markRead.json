{
  "lexicon": 1,
  "id": "dev.atmoboard.markRead",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Record how far the viewer has read a thread. Private appview state; never written to a repo. Reading also feeds the trust-level inputs, so a new level may come back.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "thread",
            "number"
          ],
          "properties": {
            "thread": {
              "type": "string",
              "minLength": 10,
              "maxLength": 10,
              "description": "Short stable key: the first 50 bits of sha256(at-uri), as 10 lowercase base32 characters."
            },
            "number": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "thread",
            "lastRead"
          ],
          "properties": {
            "thread": {
              "type": "string",
              "minLength": 10,
              "maxLength": 10,
              "description": "Short stable key: the first 50 bits of sha256(at-uri), as 10 lowercase base32 characters."
            },
            "lastRead": {
              "type": "integer"
            },
            "trustLevel": {
              "type": "integer",
              "description": "Present when this read changed the viewer's level; call admin.syncMember to publish it."
            }
          }
        }
      },
      "errors": [
        {
          "name": "NotFound"
        }
      ]
    }
  }
}
