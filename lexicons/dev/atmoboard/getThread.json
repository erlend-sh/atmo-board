{
  "lexicon": 1,
  "id": "dev.atmoboard.getThread",
  "defs": {
    "main": {
      "type": "query",
      "description": "One thread and a window of its posts around an anchor.",
      "parameters": {
        "type": "params",
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 10,
            "maxLength": 10,
            "description": "Short stable key: the first 50 bits of sha256(at-uri), as 10 lowercase base32 characters."
          },
          "anchor": {
            "type": "string",
            "description": "A post number, 'first' (default), 'last', or 'first_unread'."
          },
          "before": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "default": 0
          },
          "after": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "default": 50
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "thread",
            "posts",
            "channel",
            "permissions",
            "changeCursor"
          ],
          "properties": {
            "thread": {
              "type": "ref",
              "ref": "dev.atmoboard.defs#threadView"
            },
            "channel": {
              "type": "ref",
              "ref": "dev.atmoboard.defs#channelView"
            },
            "ancestors": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "dev.atmoboard.defs#threadView"
              }
            },
            "posts": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "dev.atmoboard.defs#postView"
              }
            },
            "hasBefore": {
              "type": "boolean"
            },
            "hasAfter": {
              "type": "boolean"
            },
            "permissions": {
              "type": "ref",
              "ref": "dev.atmoboard.defs#permissions"
            },
            "changeCursor": {
              "type": "string"
            }
          }
        }
      },
      "errors": [
        {
          "name": "NotFound"
        }
      ]
    }
  }
}
