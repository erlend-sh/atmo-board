{
  "lexicon": 1,
  "id": "dev.atmoboard.react",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "React to a post (or a thread's opening post) with one emoji. ❤️ is the Discourse-style like.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "post",
            "emoji"
          ],
          "properties": {
            "post": {
              "type": "string",
              "minLength": 10,
              "maxLength": 10,
              "description": "Post key, or a thread key for its opening post."
            },
            "emoji": {
              "type": "string",
              "maxLength": 64,
              "maxGraphemes": 1
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "post",
            "emoji"
          ],
          "properties": {
            "post": {
              "type": "string",
              "minLength": 10,
              "maxLength": 10,
              "description": "Short stable key: the first 50 bits of sha256(at-uri), as 10 lowercase base32 characters."
            },
            "emoji": {
              "type": "string"
            },
            "uri": {
              "type": "string",
              "format": "at-uri"
            }
          }
        }
      },
      "errors": [
        {
          "name": "Forbidden"
        },
        {
          "name": "NotFound"
        }
      ]
    }
  }
}
