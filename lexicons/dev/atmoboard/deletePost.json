{
  "lexicon": 1,
  "id": "dev.atmoboard.deletePost",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Delete one of the viewer's own posts. The record is deleted from the space and its history dropped; the post number stays, marked deleted. Deleting a thread's opening post deletes the thread.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "key"
          ],
          "properties": {
            "key": {
              "type": "string",
              "minLength": 10,
              "maxLength": 10,
              "description": "Short stable key: the first 50 bits of sha256(at-uri), as 10 lowercase base32 characters."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "key"
          ],
          "properties": {
            "key": {
              "type": "string",
              "minLength": 10,
              "maxLength": 10,
              "description": "Short stable key: the first 50 bits of sha256(at-uri), as 10 lowercase base32 characters."
            }
          }
        }
      },
      "errors": [
        {
          "name": "Forbidden"
        },
        {
          "name": "NotFound"
        }
      ]
    }
  }
}
