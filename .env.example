# appview/demo.sh writes a real .env for local demos. Copy this by hand only
# if you run the pieces yourself.

# Where the web server reaches HappyView.
HAPPYVIEW_URL=http://127.0.0.1:3000
# Shared with HappyView as its SESSION_SECRET (at least 32 bytes): openssl rand -hex 32
HAPPYVIEW_SESSION_SECRET=
# HappyView's encryption key for spaces and tokens: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Operator key for HappyView's admin API, printed by appview/bootstrap-admin.sh.
# Only setup scripts use it; the web app doesn't.
HAPPYVIEW_API_KEY=
# The web app's HappyView API client (POST /admin/api-clients).
HAPPYVIEW_CLIENT_KEY=
HAPPYVIEW_CLIENT_SECRET=
# The forum's group account.
ATMOBOARD_FORUM_DID=did:plc:atmoboardforum0000000000
# Signs the browser session cookie: openssl rand -hex 32
ATMOBOARD_COOKIE_SECRET=
# The public URL of the web app. OAuth redirects come back to {this}/oauth/callback;
# with https, {this}/oauth-client-metadata.json is the OAuth client_id.
ATMOBOARD_APP_URL=http://127.0.0.1:5173
# Optional guard: the client_id registered on the HappyView API client.
# HAPPYVIEW_OAUTH_CLIENT_ID=
# Persistent directory for OAuth state (a volume in production).
DATA_DIR=data
# Local demos only: sign in as any member without a PDS. Never on a public instance.
ATMOBOARD_DEV_LOGIN=1
